# run.py creates a project-owned PostgreSQL cluster by default.
# To use an existing database, copy this to .env and set MANAGED_POSTGRES=0.
# Managed mode: do NOT copy this file; run.py generates .env with new passwords.
# For a custom install path, set $env:PG_BIN before running run.py.
# External mode requires 01_schema.sql, 02_rules.sql, 04_hardening.sql,
# 05_care_roles.sql and 06_english_demo_data.sql, plus role/table grants.
MANAGED_POSTGRES=1
PG_BIN=C:/Program Files/PostgreSQL/16/bin
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=pawcare
DB_USER=pawcare_app
DB_PASSWORD=replace_locally
